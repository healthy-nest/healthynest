{
  "kind": "collectionType",
  "collectionName": "elder_nests",
  "info": {
    "singularName": "elder-nest",
    "pluralName": "elder-nests",
    "displayName": "ElderNest"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "Description": {
      "type": "text",
      "required": true
    },
    "EstablishedAt": {
      "type": "date",
      "required": true
    },
    "MaximumCapacity": {
      "type": "integer",
      "required": true
    },
    "AvailableVacancies": {
      "type": "integer",
      "required": true,
      "default": 0
    },
    "OwnershipType": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "NGO",
        "PRIVATE",
        "GOVERNMENT",
        "TRUST"
      ]
    },
    "Address": {
      "type": "component",
      "component": "shared.address",
      "repeatable": false,
      "required": true
    },
    "Specializations": {
      "type": "component",
      "component": "shared.catalog-item",
      "repeatable": true
    },
    "Amenities": {
      "type": "component",
      "component": "shared.catalog-item",
      "repeatable": true,
      "required": true
    },
    "CareTypes": {
      "type": "component",
      "component": "shared.catalog-item",
      "repeatable": true
    },
    "NestGallery": {
      "type": "media",
      "multiple": true,
      "required": true,
      "allowedTypes": [
        "images",
        "videos"
      ]
    },
    "Pricing": {
      "type": "component",
      "component": "shared.number-range",
      "repeatable": false,
      "required": true
    },
    "Banner": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "OnBoardedAt": {
      "type": "date",
      "required": true
    },
    "MedicalSupport": {
      "type": "component",
      "component": "shared.catalog-item",
      "repeatable": true
    },
    "MealSupport": {
      "type": "component",
      "component": "shared.catalog-item",
      "repeatable": true
    }
  }
}
